{
  "name": "n8n-nodes-sidequest",
  "version": "0.1.5",
  "description": "SideQuest: Hire Real People. Hire real people for real-world tasks: phone calls, store checks, inspections, errands and video capture. Paid upfront, released on verified proof. Works as an n8n AI Agent tool.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sidequest",
    "ai agent tool",
    "ai agents",
    "human in the loop",
    "hire humans",
    "real world tasks",
    "store check",
    "phone call",
    "field work",
    "gig"
  ],
  "license": "MIT",
  "homepage": "https://sidequestpays.com/docs",
  "author": {
    "name": "Crescent Harbor LLC",
    "email": "hello@sidequestpays.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidequestpays/n8n-nodes-sidequest.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/SideQuest && cp nodes/SideQuest/sidequest.svg nodes/SideQuest/sidequest.dark.svg nodes/SideQuest/SideQuest.node.json nodes/SideQuest/SideQuestTrigger.node.json dist/nodes/SideQuest/",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SideQuestApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SideQuest/SideQuest.node.js",
      "dist/nodes/SideQuest/SideQuestTrigger.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/sidequestpays/n8n-nodes-sidequest/issues"
  }
}
